{
  "expo": {
    "name": "WIEZ",
    "slug": "threadly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wiez-icon.png",
    "scheme": ["wiezmobile", "com.sotheriahq.wiez"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sotheriahq.wiez",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/wiez-adaptive-icon.png",
        "backgroundColor": "#0b0710"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/wiez-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/wiez-splash-icon.png",
          "imageWidth": 116,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0b0710",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "backgroundColor": "#00000001",
          "borderColor": "#00000001",
          "style": "light",
          "hidden": false,
          "enforceContrast": false
        }
      ],
      "./plugins/with-android-system-bars"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "position": "absolute",
        "backgroundColor": "#00000001",
        "borderColor": "#00000001",
        "style": "light",
        "hidden": false,
        "enforceContrast": false
      },
      "eas": {
        "projectId": "7a977582-8fd7-4eb5-b652-e914734702d5"
      }
    }
  }
}
